---
import BaseLayout from './BaseLayout.astro';
import SnapshotTable from '../components/SnapshotTable.astro';
import Figure from '../components/Figure.astro';
import Clip from '../components/Clip.astro';
import Lightbox from '../components/Lightbox.astro';
import assets from '../data/assets.json';

interface Props {
  title: string;
  subtitle: string;
  mode: string;
  lead: string;
  hero: { asset: string; alt?: string };
  heroDescribe: string;
  snapshot: { label: string; value: string }[];
  links?: { label: string; href: string }[];
}

const {
  title,
  subtitle,
  mode,
  lead,
  hero,
  heroDescribe,
  snapshot,
  links = [],
} = Astro.props;

// Novus leads with a clip rather than a still, so the hero follows the asset.
const entry = (assets as Record<string, { type: string }>)[hero.asset];
const HeroMedia = entry?.type === 'video' ? Clip : Figure;
---

<BaseLayout title={`${title} · Ryan Cates`} description={subtitle}>
  <article class="case-study">
    <header class="editorial-grid case-header">
      <p class="label">{mode}</p>
      <h1 class="display-1">{title}</h1>
      <p class="subtitle display-3">{subtitle}</p>
      <p class="lead">{lead}</p>
    </header>

    <div class="editorial-grid hero-row">
      <div class="wide">
        <HeroMedia asset={hero.asset} describe={heroDescribe} alt={hero.alt} ratio="16 / 10" priority />
      </div>
    </div>

    <div class="editorial-grid snapshot-row">
      <div class="wide">
        <SnapshotTable rows={snapshot} links={links} />
      </div>
    </div>

    <div class="editorial-grid prose body">
      <slot />
    </div>
  </article>

  <Lightbox />
</BaseLayout>

<style>
  /* Inter on every heading in a case study, including the ones that arrive
     through the slot. font-variation-settings has to be cleared: the display
     classes carry Fraunces axis values, and leaving them set on a font that
     has no such axes is just dead weight in the cascade. */
  .case-study :global(.display-1),
  .case-study :global(.display-2),
  .case-study :global(.display-3),
  .case-study :global(.heading),
  .case-study :global(.prose h2),
  .case-study :global(.prose h3) {
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-variation-settings: normal;
    letter-spacing: -0.025em;
  }

  /* Body copy is Hanken Grotesk, so the headings no longer get their contrast
     from a serif. Weight carries it instead. */
  .case-study :global(.display-2),
  .case-study :global(.display-3),
  .case-study :global(.heading),
  .case-study :global(.prose h2),
  .case-study :global(.prose h3) {
    font-weight: 600;
  }

  /* Down from a 96px cap. Inter sets wider than Fraunces at the same size,
     and the old h1 ran to three lines on the longer titles. */
  .case-study :global(.display-1) {
    font-size: clamp(2.25rem, 1.15rem + 4.5vw, 4.25rem);
    letter-spacing: -0.035em;
  }

  .case-header { padding-top: var(--space-9); row-gap: var(--space-4); }

  /* The deck sits under the title, so it has to be lighter than it, not
     heavier. It shares .display-3 with the First output heading, which does
     want the weight. */
  .case-study :global(.subtitle) { font-weight: 400; }

  .subtitle { color: var(--ink-2); }
  .lead { margin-top: var(--space-2); }

  .hero-row { margin-top: var(--space-7); }
  .snapshot-row { margin-top: var(--space-7); }
  .body { margin-top: var(--space-9); }

  /* Figures and comparisons break out of the reading measure. */
  .body :global(.figure-block),
  .body :global(.comparison) {
    grid-column: wide;
    margin-block: var(--space-6);
  }

  .body :global(.first-output) { grid-column: full; }

  .body :global(table:not(.snapshot)) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-small);
    margin-block: var(--space-5);
  }

  .body :global(th),
  .body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: var(--hairline) solid var(--rule);
  }

  .body :global(th) {
    font-size: var(--size-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: var(--weight-semibold);
  }
</style>
