---
// Scratch route for choosing between the two grid directions. Delete once
// one wins, along with src/pages/alt/.
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);
const first = work[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Layout comparison</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@300..800&display=swap"
    />
  </head>
  <body>
    <header class="bar">
      <h1>Layout comparison</h1>

      <label>
        <span>Case study</span>
        <select id="slug">
          {work.map((entry) => (
            <option value={entry.id} selected={entry.id === first.id}>
              {entry.data.title}{entry.data.draft ? ' (stub)' : ''}
            </option>
          ))}
        </select>
      </label>

      <div class="widths" role="group" aria-label="Viewport width">
        <button type="button" data-width="1440" class="is-on">1440</button>
        <button type="button" data-width="1024">1024</button>
        <button type="button" data-width="375">375</button>
      </div>

      <label class="sync">
        <input type="checkbox" id="sync" checked />
        <span>Sync scroll</span>
      </label>
    </header>

    <div class="panes">
      <section class="pane">
        <div class="pane-head">
          <h2>A · Asymmetric rail <span>chosen</span></h2>
          <a id="link-a" href={`/work/${first.id}`} target="_blank" rel="noreferrer">Open</a>
        </div>
        <div class="viewport"><iframe id="frame-a" title="Asymmetric rail layout" src={`/work/${first.id}`}></iframe></div>
      </section>

      <section class="pane">
        <div class="pane-head">
          <h2>B · Centered measure <span>fallback</span></h2>
          <a id="link-b" href={`/alt/${first.id}`} target="_blank" rel="noreferrer">Open</a>
        </div>
        <div class="viewport"><iframe id="frame-b" title="Centered measure layout" src={`/alt/${first.id}`}></iframe></div>
      </section>
    </div>

    <script>
      const frameA = document.getElementById('frame-a') as HTMLIFrameElement;
      const frameB = document.getElementById('frame-b') as HTMLIFrameElement;
      const frames = [frameA, frameB];
      const linkA = document.getElementById('link-a') as HTMLAnchorElement;
      const linkB = document.getElementById('link-b') as HTMLAnchorElement;
      const slugSelect = document.getElementById('slug') as HTMLSelectElement;
      const syncToggle = document.getElementById('sync') as HTMLInputElement;

      let frameWidth = 1440;

      // Render each pane at a real viewport width, then scale it down to fit,
      // so both layouts are compared at the same true width.
      function fit() {
        for (const frame of frames) {
          const viewport = frame.parentElement as HTMLElement;
          const scale = Math.min(1, viewport.clientWidth / frameWidth);
          frame.style.width = `${frameWidth}px`;
          frame.style.height = `${viewport.clientHeight / scale}px`;
          frame.style.transform = `scale(${scale})`;
        }
      }

      new ResizeObserver(fit).observe(document.querySelector('.panes') as Element);
      fit();

      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-width]')) {
        button.addEventListener('click', () => {
          frameWidth = Number(button.dataset.width);
          for (const other of document.querySelectorAll('[data-width]')) {
            other.classList.toggle('is-on', other === button);
          }
          fit();
        });
      }

      slugSelect.addEventListener('change', () => {
        const slug = slugSelect.value;
        frameA.src = `/work/${slug}`;
        frameB.src = `/alt/${slug}`;
        linkA.href = `/work/${slug}`;
        linkB.href = `/alt/${slug}`;
      });

      let locked = false;

      function wire(source: HTMLIFrameElement, target: HTMLIFrameElement) {
        const win = source.contentWindow;
        if (!win) return;
        win.addEventListener('scroll', () => {
          if (locked || !syncToggle.checked) return;
          locked = true;
          target.contentWindow?.scrollTo(0, win.scrollY);
          requestAnimationFrame(() => { locked = false; });
        });
      }

      for (const frame of frames) {
        frame.addEventListener('load', () => {
          fit();
          wire(frame, frame === frameA ? frameB : frameA);
        });
      }
    </script>

    <style>
      :root { color-scheme: light; }

      body {
        margin: 0;
        font-family: 'Hanken Grotesk', system-ui, sans-serif;
        background: #e8e5e0;
        color: #17191b;
        height: 100dvh;
        display: flex;
        flex-direction: column;
      }

      .bar {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
        padding: 0.75rem 1rem;
        background: #faf9f7;
        border-bottom: 1px solid #cbc7bf;
      }

      h1 { font-size: 0.8125rem; text-transform: uppercase; letter-spacing: 0.08em; margin: 0; color: #74777a; }

      label { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; }
      label span { color: #46494c; }

      select {
        font: inherit;
        padding: 0.25rem 0.5rem;
        border: 1px solid #cbc7bf;
        border-radius: 3px;
        background: #fff;
      }

      .widths { display: flex; gap: 2px; }

      .widths button {
        font: inherit;
        font-size: 0.8125rem;
        padding: 0.3rem 0.7rem;
        border: 1px solid #cbc7bf;
        background: #fff;
        cursor: pointer;
      }

      .widths button:first-child { border-radius: 3px 0 0 3px; }
      .widths button:last-child { border-radius: 0 3px 3px 0; }
      .widths button.is-on { background: #17191b; color: #faf9f7; border-color: #17191b; }

      .sync { margin-left: auto; }

      .panes {
        flex: 1;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1px;
        background: #cbc7bf;
        min-height: 0;
      }

      .pane { display: flex; flex-direction: column; min-width: 0; background: #faf9f7; }

      .pane-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid #e2dfd9;
      }

      .pane-head h2 { font-size: 0.8125rem; margin: 0; font-weight: 600; }
      .pane-head span { color: #9b9ea1; font-weight: 400; }
      .pane-head a { font-size: 0.8125rem; color: #46494c; }

      .viewport { flex: 1; overflow: hidden; min-height: 0; }

      iframe {
        border: 0;
        display: block;
        transform-origin: top left;
        background: #faf9f7;
      }
    </style>
  </body>
</html>
