---
export type TechIconId = 'nextjs' | 'react' | 'typescript' | 'tailwind';

interface Props {
  id: TechIconId;
  size?: number;
}

const { id, size = 18 } = Astro.props;

const label: Record<TechIconId, string> = {
  nextjs: 'Next.js',
  react: 'React',
  typescript: 'TypeScript',
  tailwind: 'Tailwind CSS',
};

const raster: Record<TechIconId, string> = {
  nextjs: '/icons/stack/nextjs.png',
  react: '/icons/stack/react.png',
  typescript: '/icons/stack/typescript.png',
  tailwind: '/icons/stack/tailwind.png',
};

const tipId = `stack-tip-${id}`;
---

<span class="tech-icon" tabindex="0" role="img" aria-label={label[id]}>
  <img
    src={raster[id]}
    width={size}
    height={size}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
  />
  <span id={tipId} class="tooltip" role="tooltip">
    {label[id]}
  </span>
</span>

<style>
  .tech-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 0;
    cursor: default;
    border-radius: var(--radius-sm);
  }

  .tech-icon:focus {
    outline: none;
  }

  .tech-icon:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .tech-icon img {
    display: block;
    object-fit: contain;
    pointer-events: none;
  }

  .tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    z-index: 2;
    padding: 5px 9px;
    font-family: var(--font-body);
    font-size: var(--size-caption);
    font-weight: var(--weight-medium);
    line-height: 1.25;
    letter-spacing: 0;
    text-transform: none;
    color: var(--paper);
    white-space: nowrap;
    pointer-events: none;
    background: var(--ink);
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px rgb(23 25 27 / 14%);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(4px);
    transition:
      opacity var(--dur-2) var(--ease-out),
      visibility var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    width: 0;
    height: 0;
    margin-left: -5px;
    border: 5px solid transparent;
    border-top-color: var(--ink);
  }

  .tech-icon:hover .tooltip,
  .tech-icon:focus-visible .tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .tooltip {
      transition: none;
      transform: translateX(-50%);
    }

    .tech-icon:hover .tooltip,
    .tech-icon:focus-visible .tooltip {
      transform: translateX(-50%);
    }
  }
</style>