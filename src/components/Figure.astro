---
import assets from '../data/assets.json';

interface Props {
  /** Key into docs/portfolio/asset-manifest.md. Not Astro's reserved `slot`. */
  asset: string;
  /** Slot description from the content, shown while the capture is missing. */
  describe: string;
  alt?: string;
  caption?: string;
  credit?: string;
  ratio?: string;
  priority?: boolean;
}

const {
  asset,
  describe,
  alt,
  caption,
  credit,
  ratio = '16 / 9',
  priority = false,
} = Astro.props;

type Entry = { type: string; width: number; height: number; widths: number[] };
const entry = (assets as Record<string, Entry>)[asset];
const pending = !entry;

const srcset = (ext: string) =>
  entry.widths.map((w) => `/img/${asset}-${w}.${ext} ${w}w`).join(', ');
const sizes = '(max-width: 60rem) 100vw, 960px';
---

<figure class="figure-block" data-asset={asset}>
  {pending ? (
    <div class="placeholder" style={`aspect-ratio: ${ratio}`}>
      <p class="label">Image slot</p>
      <p class="caption describe">{describe}</p>
      <p class="caption key">{asset}</p>
    </div>
  ) : (
    <button type="button" class="zoom" data-zoom>
      <picture>
        <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
        <img
          src={`/img/${asset}-${entry.widths.at(-1)}.webp`}
          srcset={srcset('webp')}
          sizes={sizes}
          width={entry.width}
          height={entry.height}
          alt={alt}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={priority ? 'high' : undefined}
        />
      </picture>
      {/* Keeps the alt text as the button's name and adds the action to it. */}
      <span class="visually-hidden">Enlarge image</span>
    </button>
  )}

  {(caption || credit) && (
    <figcaption>
      {caption && <p class="caption">{caption}</p>}
      {credit && <p class="caption credit">{credit}</p>}
    </figcaption>
  )}
</figure>

<style>
  .figure-block {
    margin: 0;
    background: var(--figure-surface);
    border: var(--hairline) solid var(--figure-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }

  figcaption {
    padding: var(--space-3) var(--space-1) var(--space-1);
    max-width: var(--measure);
  }

  figcaption > * + * { margin-top: var(--space-2); }
  .credit { color: var(--ink-4); }

  .placeholder {
    display: grid;
    place-content: center;
    gap: var(--space-2);
    padding: var(--space-5);
    text-align: center;
    background: #1b1d20;
    border-radius: var(--radius-sm);
  }

  .placeholder .label { color: #8a8f94; }
  .describe { color: #b6babd; max-width: 48ch; }
  .key { color: #6d7276; }

  img { border-radius: var(--radius-sm); width: 100%; }

  .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: var(--radius-sm);
  }

  .zoom:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 3px;
  }
</style>
