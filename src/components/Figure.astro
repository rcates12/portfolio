---
interface Props {
  /** Key into docs/portfolio/asset-manifest.md. Not Astro's reserved `slot`. */
  asset: string;
  /** Slot description from the content, shown while the capture is missing. */
  describe: string;
  alt?: string;
  src?: string;
  caption?: string;
  credit?: string;
  ratio?: string;
}

const {
  asset,
  describe,
  alt,
  src,
  caption,
  credit,
  ratio = '16 / 9',
} = Astro.props;

const pending = !src;
---

<div class="figure-block">
  <div class="rail-side">
    {caption && <p class="caption">{caption}</p>}
    {credit && <p class="caption credit">{credit}</p>}
  </div>

  <figure class="figure" data-asset={asset}>
    {pending ? (
      <div class="placeholder" style={`aspect-ratio: ${ratio}`}>
        <p class="label">Image slot</p>
        <p class="caption describe">{describe}</p>
        <p class="caption key">{asset}</p>
      </div>
    ) : (
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    )}
  </figure>
</div>

<style>
  /* Own two-column unit rather than relying on grid auto-placement, which
     would drop the rail caption into the row above the figure. */
  .figure-block {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--rail-gap);
    align-items: start;
  }

  .rail-side > * + * { margin-top: var(--space-2); }
  .credit { color: var(--ink-4); }

  .figure {
    margin: 0;
    background: var(--figure-surface);
    border: var(--hairline) solid var(--figure-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
  }

  .placeholder {
    display: grid;
    place-content: center;
    gap: var(--space-2);
    padding: var(--space-5);
    text-align: center;
    background: #1b1d20;
    border-radius: var(--radius-sm);
    color: #8a8f94;
  }

  .placeholder .label { color: #8a8f94; }
  .describe { color: #b6babd; max-width: 48ch; }
  .key { color: #6d7276; }

  img { border-radius: var(--radius-sm); width: 100%; }

  @media (max-width: 60rem) {
    .figure-block { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-3); }
    .rail-side { order: 2; }
  }
</style>
