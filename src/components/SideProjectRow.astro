---
import assets from '../data/assets.json';

interface Props {
  href: string;
  title: string;
  line: string;
  asset: string;
  alt: string;
}

const { href, title, line, asset, alt } = Astro.props;

type Entry = { type: string; width: number; height: number; widths: number[] };
const entry = (assets as Record<string, Entry>)[asset];
const pending = !entry;

const srcset = (ext: string) =>
  entry?.widths.map((w) => `/img/${asset}-${w}.${ext} ${w}w`).join(', ') ?? '';
const sizes = '(max-width: 36rem) 100vw, 200px';
---

<article class="side-project">
  <div class="thumb" aria-hidden="true">
    {pending ? (
      <div class="thumb-placeholder" />
    ) : (
      <picture>
        <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
        <img
          src={`/img/${asset}-${entry.widths.at(-1)}.webp`}
          srcset={srcset('webp')}
          sizes={sizes}
          width={entry.width}
          height={entry.height}
          alt={alt}
          loading="lazy"
          decoding="async"
        />
      </picture>
    )}
  </div>

  <div class="copy">
    <h3 class="title">
      <a href={href}>{title}</a>
    </h3>
    <p class="line">{line}</p>
    <!-- Same destination as the title link, so it is not a second link. -->
    <span class="cta" aria-hidden="true">View project</span>
  </div>
</article>

<style>
  .side-project {
    position: relative;
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    align-items: start;
    gap: 0 var(--space-5);
    max-width: 40rem;
  }

  .thumb {
    display: block;
    width: 200px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--paper-sunk);
    border: var(--hairline) solid var(--rule);
    text-decoration: none;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--paper-sunk);
  }

  .copy {
    min-width: 0;
    padding-top: 2px;
  }

  .title {
    margin: 0 0 6px;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* One link per row: the title's hit area stretches over the whole row, so
     the image and description go to the same page. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Same label treatment as "View case study" on the cards above. */
  .cta {
    display: block;
    width: fit-content;
    margin-top: var(--space-3);
    padding-bottom: 3px;
    border-bottom: 2px solid currentColor;
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition: color var(--dur-2) var(--ease-out);
  }

  .side-project:hover .cta {
    color: var(--ink);
  }

  .title a:focus-visible {
    outline: none;
  }

  .title a:focus-visible::after {
    outline: var(--focus-ring);
    outline-offset: 6px;
    border-radius: var(--radius-sm);
  }

  .line {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--ink-2);
  }

  @media (max-width: 36rem) {
    /* Text first, image below it at the full column width. */
    .side-project {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4) 0;
    }

    .copy { order: 1; }

    .thumb {
      order: 2;
      width: 100%;
    }
  }
</style>