---
/** The signature device. Heading text differs on every case study, so it
 *  comes from the content; only the treatment is shared. */
interface Props {
  heading: string;
  /** Novus heads this section differently, so the eyebrow is optional. */
  eyebrow?: string;
}

const { heading, eyebrow } = Astro.props;
---

<section class="first-output" aria-labelledby="first-output">
  <div class="inner">
    {eyebrow && <p class="label">{eyebrow}</p>}
    <h2 id="first-output" class="display-3">{heading}</h2>
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style>
  .first-output {
    background: var(--paper-sunk);
    border-block: var(--hairline) solid var(--rule);
    padding-block: var(--section-gap);
    margin-block: var(--section-gap);
  }

  .inner {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    column-gap: var(--rail-gap);
    align-items: start;
    max-width: calc(var(--rail) + var(--rail-gap) + var(--measure) + 14rem);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .label { grid-column: 1; }
  h2 { grid-column: 2; margin: 0 0 var(--space-5); }
  .body { grid-column: 2; }

  /* Markdown inside the slot: the table is the centrepiece. */
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--size-small);
    margin-block: var(--space-5);
  }

  .body :global(th),
  .body :global(td) {
    text-align: left;
    vertical-align: top;
    padding: var(--space-3) var(--space-4) var(--space-3) 0;
    border-bottom: var(--hairline) solid var(--rule-strong);
  }

  .body :global(th) {
    font-size: var(--size-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-3);
    font-weight: var(--weight-semibold);
    border-bottom-width: 2px;
  }

  .body :global(td:last-child) { color: var(--ink-2); }

  .body :global(p) { margin: 0 0 var(--space-4); max-width: var(--measure); }
  .body :global(p:last-child) { margin-bottom: 0; }

  @media (max-width: 60rem) {
    .inner { grid-template-columns: minmax(0, 1fr); row-gap: var(--space-3); }
    .label, h2, .body { grid-column: 1; }
  }
</style>
